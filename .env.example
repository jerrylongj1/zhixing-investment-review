# Set in server environment. Never expose values to frontend or commit .env.
DATABASE_PATH=data/zhixing.db
COOKIE_SECURE=0
PORT=8000
# Optional runtime model. Explicit AI mode sends selected evidence to this service.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# Optional Fuyao historical daily bars. Unknown original publication stays unknown.
# FUYAO_API_KEY=
# Optional read-only, reviewed bare Git source snapshot, never user data:
# PUBLIC_SOURCE_PATH=

# Canonical HTTPS origin when a reverse proxy terminates TLS:
# PUBLIC_ORIGIN=https://example.com
